{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlockerRecord",
  "description": "Strict schema for a canonical single blocker record stored in .agents/state/blockers/BLK-xxx.json.",
  "type": "object",
  "required": [
    "id",
    "status",
    "what",
    "why",
    "owner",
    "decisionNeeded",
    "unblockCondition",
    "severity",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^(?:BLK|BLOCKER)-[0-9]{3,}$"
    },
    "taskId": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "resolved"]
    },
    "scope": {
      "type": "string",
      "enum": ["task", "project", "global", "resource"],
      "default": "task"
    },
    "what": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string"
    },
    "why": {
      "type": "string",
      "minLength": 3
    },
    "owner": {
      "type": "string"
    },
    "decisionNeeded": {
      "type": "string"
    },
    "unblockCondition": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "createdAt": {
      "type": "string"
    },
    "resolvedAt": {
      "type": ["string", "null"]
    },
    "resolution": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "resolved" } }
      },
      "then": {
        "required": ["resolvedAt", "resolution"],
        "properties": {
          "resolvedAt": { "type": "string", "minLength": 5 },
          "resolution": { "type": "string", "minLength": 3 }
        }
      }
    }
  ]
}
