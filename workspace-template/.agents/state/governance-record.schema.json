{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.internal/schemas/governance-record.schema.json",
  "title": "CanonicalGovernanceRecord",
  "description": "Strict schema for a canonical single task governance record stored in .agents/state/governance/TASK-xxx.json.",
  "type": "object",
  "required": [
    "taskId",
    "classification",
    "requiredRules",
    "requiredSkills",
    "requiredTechnologyProfiles",
    "governanceStatus"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "classification": {
      "type": "object",
      "required": ["type", "risk"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "simple",
            "bug",
            "bugfix",
            "feature",
            "complex-feature",
            "refactor",
            "architecture",
            "security",
            "database",
            "migration",
            "performance",
            "testing",
            "test",
            "deployment",
            "documentation",
            "docs",
            "requirements",
            "investigation",
            "infrastructure"
          ]
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "lane": {
          "type": "string",
          "enum": ["A", "B", "C"]
        }
      },
      "additionalProperties": false
    },
    "requiredRules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RULE-[A-Z0-9_-]+$"
      }
    },
    "requiredSkills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SKILL-[A-Z0-9_-]+$"
      }
    },
    "requiredTechnologyProfiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relevantAdrs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualityGates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qualityGate"
      }
    },
    "securityChecks": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/securityCheck" },
          { "type": "string" }
        ]
      }
    },
    "memorySyncRequired": {
      "type": "boolean"
    },
    "memorySyncCompleted": {
      "type": "boolean"
    },
    "approvalRequirements": {
      "type": "object",
      "required": ["required", "satisfied"],
      "properties": {
        "required": { "type": "boolean" },
        "satisfied": { "type": "boolean" },
        "approver": { "type": ["string", "null"] },
        "approvalSource": { "type": ["string", "null"] },
        "approvalId": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] },
        "approvalEvidence": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "evidenceRequirements": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/evidenceRequirement" },
          { "type": "string" }
        ]
      }
    },
    "diffReview": {
      "$ref": "#/$defs/diffReview"
    },
    "acceptanceCriteriaEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptanceCriterionEvidence"
      }
    },
    "governanceStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "in_progress",
        "verification_required",
        "blocked",
        "failed",
        "complete"
      ]
    },
    "override": {
      "type": "object",
      "properties": {
        "requested": { "type": "boolean" },
        "granted": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "actor": { "type": ["string", "null"] },
        "timestamp": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "completedAt": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "qualityGate": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["test", "lint", "typecheck", "build", "security", "diff-review", "memory-sync", "adr"]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked",
            "not_applicable",
            "not_configured",
            "unknown"
          ]
        },
        "command": {
          "type": ["string", "null"]
        },
        "exitCode": {
          "type": ["integer", "null"]
        },
        "evidence": {
          "type": ["string", "null"]
        },
        "evidenceRef": {
          "$ref": "#/$defs/evidenceRef"
        },
        "applicabilityEvidence": {
          "type": ["object", "string", "null"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "securityCheck": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked",
            "not_applicable",
            "not_configured",
            "unknown"
          ]
        },
        "command": {
          "type": ["string", "null"]
        },
        "exitCode": {
          "type": ["integer", "null"]
        },
        "tool": {
          "type": ["string", "null"]
        },
        "toolVersion": {
          "type": ["string", "null"]
        },
        "scope": {
          "type": ["string", "null"]
        },
        "evidence": {
          "type": ["string", "null"]
        },
        "evidenceRef": {
          "$ref": "#/$defs/evidenceRef"
        },
        "reason": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "evidenceRequirement": {
      "type": "object",
      "required": ["description", "status"],
      "properties": {
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "required",
            "satisfied",
            "unsatisfied",
            "not_applicable",
            "blocked"
          ]
        },
        "evidence": {
          "type": ["string", "null"]
        },
        "evidenceRef": {
          "$ref": "#/$defs/evidenceRef"
        },
        "reason": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "diffReview": {
      "type": "object",
      "required": ["status", "filesReviewed", "unrelatedChangesDetected"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["reviewed", "passed", "not_applicable"]
        },
        "filesReviewed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unrelatedChangesDetected": {
          "type": "boolean"
        },
        "reviewId": {
          "type": ["string", "null"]
        },
        "reviewer": {
          "type": ["string", "null"]
        },
        "reviewerAgent": {
          "type": ["string", "null"]
        },
        "commit": {
          "type": ["string", "null"]
        },
        "baseCommit": {
          "type": ["string", "null"]
        },
        "baseSha": {
          "type": ["string", "null"]
        },
        "findings": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "evidence": {
          "type": ["string", "null"]
        },
        "evidenceRef": {
          "$ref": "#/$defs/evidenceRef"
        },
        "reason": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "acceptanceCriterionEvidence": {
      "type": "object",
      "required": ["criterion", "status", "evidence"],
      "properties": {
        "criterion": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["satisfied", "unsatisfied", "not_applicable"]
        },
        "evidence": {
          "type": "string"
        },
        "evidenceRef": {
          "$ref": "#/$defs/evidenceRef"
        },
        "reason": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ci-artifact", "local-command", "artifact-review", "manual-checkpoint"]
        },
        "source": { "type": ["string", "null"] },
        "runId": { "type": ["string", "null"] },
        "artifact": { "type": ["string", "null"] },
        "command": { "type": ["string", "null"] },
        "exitCode": { "type": ["integer", "null"] },
        "commit": { "type": ["string", "null"] },
        "capturedAt": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
