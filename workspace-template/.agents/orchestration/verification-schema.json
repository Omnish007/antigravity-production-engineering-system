{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AntigravityTaskVerificationEvidence",
  "description": "Machine-readable contract for task verification evidence. Used by quality-gates skill and CI/CD gating to evaluate agent output.",
  "type": "object",
  "required": [
    "taskId",
    "verifiedAt",
    "status",
    "acceptanceCriteria",
    "filesChanged"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable task identifier (e.g., TASK-001)"
    },
    "taskType": {
      "type": "string",
      "enum": ["feature", "bugfix", "refactor", "performance", "review", "deployment", "infrastructure", "migration", "documentation"],
      "description": "Task type from task-classifier.md"
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Risk classification from task-classifier.md"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verifiedBy": {
      "type": "string",
      "description": "Agent or role that performed verification"
    },
    "status": {
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED",
        "PASSED_WITH_WARNINGS"
      ]
    },
    "commandsExecuted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exitCode"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exitCode": {
            "type": "integer"
          },
          "duration": {
            "type": "string",
            "description": "Execution duration (e.g., '12.3s')"
          },
          "stdoutExcerpt": {
            "type": "string"
          },
          "stderrExcerpt": {
            "type": "string"
          }
        }
      }
    },
    "testsRun": {
      "type": "integer",
      "minimum": 0
    },
    "testsPassed": {
      "type": "integer",
      "minimum": 0
    },
    "testsFailed": {
      "type": "integer",
      "minimum": 0
    },
    "testsSkipped": {
      "type": "integer",
      "minimum": 0
    },
    "coverageDelta": {
      "type": "string",
      "description": "Coverage change from this task (e.g., '+2.3%', '-0.1%', 'no change')"
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "status"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "SKIPPED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "followUp": {
            "type": "string"
          }
        }
      }
    },
    "qualityChecks": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "description": "PASSED | FAILED | SKIPPED | NOT_CONFIGURED"
        },
        "lint": {
          "type": "string"
        },
        "typecheck": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "security": {
          "type": "string"
        },
        "accessibility": {
          "type": "string"
        },
        "performance": {
          "type": "string"
        }
      }
    },
    "performanceMetrics": {
      "type": "object",
      "description": "Pre/post performance comparison when applicable",
      "properties": {
        "baseline": { "type": "object" },
        "current": { "type": "object" },
        "regression": { "type": "boolean" }
      }
    },
    "trajectory": {
      "type": "object",
      "description": "Agent execution path evaluation",
      "properties": {
        "planFollowed": {
          "type": "string",
          "enum": ["yes", "no", "adapted"]
        },
        "doomLoops": {
          "type": "boolean"
        },
        "scopeMaintained": {
          "type": "boolean"
        },
        "recoveryActions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memoryUpdates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
