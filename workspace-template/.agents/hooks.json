{
  "session-bootstrap": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 .agents/skills/quality-gates/scripts/bootstrap-session.py",
        "timeout": 20
      }
    ]
  },
  "pretool-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/skills/quality-gates/scripts/hook-pre-tool.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "posttool-audit": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/skills/quality-gates/scripts/hook-post-tool.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "stop-governance-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 .agents/skills/quality-gates/scripts/hook-stop.py",
        "timeout": 30
      }
    ]
  }
}
